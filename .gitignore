# ============================================
# Unreal Engine 5.6 - .gitignore
# ============================================

# --- Derlenmiş çıktılar ve geçici klasörler ---
Binaries/
Build/
DerivedDataCache/
Intermediate/
Saved/

# Eklentiler (Plugins) içindeki aynı klasörler
Plugins/**/Binaries/
Plugins/**/Build/
Plugins/**/Intermediate/
Plugins/**/Saved/

# Marketplace/motor eklentilerinin cache'i
Plugins/**/NoRedist/
Plugins/**/RestrictedFolders/

# --- Paketlenmiş buildler ---
Packaged/
Builds/
Dist/
Output/

# --- Visual Studio / Rider / VS Code ---
.vs/
.vscode/
.idea/
*.sln
*.suo
*.sdf
*.opensdf
*.VC.db
*.VC.VC.opendb
*.vcxproj
*.vcxproj.filters
*.vcxproj.user
*.xcodeproj/
*.xcworkspace/
.vsconfig

# Rider'ın proje içi klasörü (takımla paylaşmak isterseniz bu satırı silin)
*.DotSettings.user

# --- Linux/Make dosyaları (UE tarafından üretilir) ---
Makefile
CMakeLists.txt
.ignore
compile_commands.json

# --- Crash / log artıkları ---
*.log
*.tlog
*.pdb
*.idb
*.ipch
*.obj
*.dll
*.exe
*.lib
*.exp
*.stackdump

# --- İşletim sistemi çöpleri ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# --- Yerel ayarlar / gizli bilgiler ---
# Steam App ID, oturum anahtarları vb. asla repoya girmesin
*.env
.env.local
steam_appid.txt
Config/*Local*.ini
Config/**/DefaultEngine_Local.ini

# --- Oyuncu kayıtları (SaveGame) ---
# Her oyuncunun kendi ayarları/karakter kayıtları kendi bilgisayarında kalmalı.
# UE kayıtları Saved/SaveGames/ altına .sav olarak yazar (Saved/ zaten ignore),
# ama başka bir yere kopyalanırsa diye ekstra güvenlik:
*.sav
SaveGames/
# Grafik/çözünürlük ayarları (GameUserSettings) da kişisel:
GameUserSettings.ini
# NOT: SG_Settings.uasset gibi SaveGame *Blueprint*'leri Content/ içindedir
# ve repoda KALMALIDIR. Burada sadece oyuncunun kayıt dosyaları engelleniyor.

# ============================================
# ÖNEMLİ: Aşağıdakiler repoda KALMALI
# (yanlışlıkla ignore edilmesin diye not)
# ============================================
# Content/        -> tüm asset'ler (Git LFS ile)
# Config/         -> proje ayarları
# Source/         -> C++ kodu
# *.uproject      -> proje dosyası
# Plugins/*/Source, *.uplugin
